      "paths": [
        "agents/common/security-reviewer.md"
      ],
      "targets": [
        "claude",
        "agents"
      ],
      "dependencies": [
        "agents-core",
        "skills-core"
      ],
      "defaultInstall": false,
      "cost": "light",
      "stability": "experimental"
    }
