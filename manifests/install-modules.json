      "targets": [
        "claude",
        "agents"
      ],
      "dependencies": [],
      "defaultInstall": true,
      "cost": "light",
      "stability": "experimental"
    },
    {
      "id": "sdd-skills",
      "kind": "skills",
      "description": "Spec-Driven Development lifecycle skills.",
      "paths": [
        "skills/common/sdd",
        "skills/common/sdd-init",
        "skills/common/sdd-explore",
        "skills/common/sdd-propose",
        "skills/common/sdd-spec",
        "skills/common/sdd-design",
        "skills/common/sdd-tasks",
        "skills/common/sdd-apply",
