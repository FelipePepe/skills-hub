{
  "apps": [
    {
      "id": "copilot",
      "description": "GitHub Copilot local skills directory",
      "installPath": {
        "linux": "~/.copilot/skills",
        "windows": "%USERPROFILE%/.copilot/skills"
      },
      "detectPaths": {
        "linux": [
          "~/.copilot",
          "~/.copilot/skills"
        ],
        "windows": [
          "%USERPROFILE%/.copilot",
          "%USERPROFILE%/.copilot/skills"
        ]
      },
      "sources": [
        "skills/common",
        "skills/backend",
        "skills/frontend",
        "skills/copilot-only"
      ],
      "configFiles": [
        {
          "source": "behavior/copilot/copilot-instructions.md",
          "target": {
            "linux": "~/.copilot/copilot-instructions.md",
            "windows": "%USERPROFILE%/.copilot/copilot-instructions.md"
          },
          "strategy": "copy"
        }
      ]
    },
    {
      "id": "claude",
      "description": "Claude local skills directory",
      "installPath": {
        "linux": "~/.claude/skills",
        "windows": "%USERPROFILE%/.claude/skills"
      },
      "detectPaths": {
        "linux": [
          "~/.claude",
          "~/.claude/skills"
        ],
        "windows": [
          "%USERPROFILE%/.claude",
          "%USERPROFILE%/.claude/skills"
        ]
      },
      "sources": [
        "skills/common",
        "skills/backend",
        "skills/frontend",
        "skills/claude-only"
      ],
      "configFiles": [
        {
          "source": "behavior/claude/CLAUDE.md",
          "target": {
            "linux": "~/.claude/CLAUDE.md",
            "windows": "%USERPROFILE%/.claude/CLAUDE.md"
          },
          "strategy": "copy"
        },
        {
          "source": "mcp/claude.managed.json",
          "target": {
            "linux": "~/.claude.json",
            "windows": "%USERPROFILE%/.claude.json"
          },
          "strategy": "json-merge"
        }
      ]
    },
    {
      "id": "agents",
      "description": "Generic agents local skills directory",
      "installPath": {
        "linux": "~/.agents/skills",
        "windows": "%USERPROFILE%/.agents/skills"
      },
      "detectPaths": {
        "linux": [
          "~/.agents",
          "~/.agents/skills"
        ],
        "windows": [
          "%USERPROFILE%/.agents",
          "%USERPROFILE%/.agents/skills"
        ]
      },
      "sources": [
        "skills/common",
        "skills/backend",
        "skills/frontend"
      ]
    },
    {
      "id": "opencode",
      "description": "OpenCode managed configuration",
      "installPath": {
        "linux": "~/.config/opencode",
        "windows": "%USERPROFILE%/.config/opencode"
      },
      "detectPaths": {
        "linux": [
          "~/.config/opencode",
          "~/.opencode"
        ],
        "windows": [
          "%USERPROFILE%/.config/opencode",
          "%USERPROFILE%/.opencode"
        ]
      },
      "sources": [],
      "configFiles": [
        {
          "source": "opencode/opencode.managed.json",
          "target": {
            "linux": "~/.config/opencode/opencode.json",
            "windows": "%USERPROFILE%/.config/opencode/opencode.json"
          },
          "strategy": "json-merge"
        },
        {
          "source": "opencode/AGENTS.md",
          "target": {
            "linux": "~/.opencode/AGENTS.md",
            "windows": "%USERPROFILE%/.opencode/AGENTS.md"
          },
          "strategy": "markdown-managed-block",
          "blockId": "opencode-routing"
        }
      ]
    },
    {
      "id": "vscode",
      "description": "VS Code user-level MCP configuration (GitHub Copilot Chat)",
      "installPath": {
        "linux": "~/.config/Code/User",
        "windows": "%USERPROFILE%/AppData/Roaming/Code/User"
      },
      "detectPaths": {
        "linux": [
          "~/.config/Code/User"
        ],
        "windows": [
          "%USERPROFILE%/AppData/Roaming/Code/User"
        ]
      },
      "sources": [],
      "configFiles": [
        {
          "source": "mcp/vscode.managed.json",
          "target": {
            "linux": "~/.config/Code/User/mcp.json",
            "windows": "%USERPROFILE%/AppData/Roaming/Code/User/mcp.json"
          },
          "strategy": "json-merge"
        }
      ]
    }
  ]
}
