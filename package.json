{
  "name": "skills-hub",
  "version": "2.8.0",
  "private": true,
  "description": "CLI para instalar y exponer el catalogo de skills en las apps locales compatibles.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "skills-hub": "./bin/skills-hub.js",
    "copilot-credits": "./bin/copilot-credits.js"
  },
  "scripts": {
    "skills-hub": "node ./bin/skills-hub.js",
    "lint": "./scripts/lint.sh",
    "doctor": "./scripts/doctor.sh",
    "doctor:skills": "./scripts/doctor-skills.sh",
    "registry:skills": "node ./bin/skills-hub.js registry list",
    "check": "./scripts/check.sh",
    "sync": "./scripts/sync.sh",
    "install:skills": "node ./bin/skills-hub.js install",
    "status:skills": "node ./bin/skills-hub.js status",
    "bootstrap": "./scripts/bootstrap.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
